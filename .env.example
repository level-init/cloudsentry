# Local Compose Postgres. App persistence only — not a cloud credential.
POSTGRES_USER=cloudsentry
POSTGRES_PASSWORD=cloudsentry
POSTGRES_DB=cloudsentry
DATABASE_URL=postgresql://cloudsentry:cloudsentry@localhost:5432/cloudsentry
# Optional isolated DB for pytest. When unset, tests use DATABASE_URL (same Compose
# Postgres as the API/worker). Committed ingest rows are visible to tests and can
# collide with create(); prefer upsert seeds or set this to a separate database.
# TEST_DATABASE_URL=postgresql://cloudsentry:cloudsentry@localhost:5432/cloudsentry_test

# Simulator HTTP target. The local simulator needs no access keys.
# The API and worker call this URL over HTTP and do not import the simulator package.
# Keep mutate traffic on this base URL only (least privilege for v1).
SIMULATOR_BASE_URL=http://127.0.0.1:8001

# Optional bearer for a future authenticated simulator gateway. Leave blank locally.
# Never commit a real token. Prefer short-lived, mutate-scoped credentials injected
# by the runtime (role assumption / secret manager), not long-lived keys in git.
SIMULATOR_MUTATE_TOKEN=

# Fake-repo Terraform review path. Review only; CloudSentry does not apply to AWS in v1.
TERRAFORM_CHANGES_DIR=terraform/changes

RIGHTSIZING_HEADROOM=0.5
RIGHTSIZING_AVG_MAX=15
STORAGE_AGE_DAYS=30
LIFECYCLE_COST_CENTS=5000
LIFECYCLE_RETENTION_DAYS=90
DETECTION_INTERVAL_SECONDS=3600
EXPLAINER=stub
EXPLAINER_BASE_URL=https://api.openai.com/v1
# Optional LLM key for the explainer. Leave blank for the stub. Never commit a real key.
EXPLAINER_API_KEY=
EXPLAINER_MODEL=gpt-4o-mini
NEGOTIATION_ENABLED=false
SLACK_WEBHOOK_ENABLED=false

# Cloud apply is out of scope for MVP. When it lands, inject short-lived
# least-privilege cloud credentials via the environment (for example a scoped
# role ARN or temporary access keys). Do not store production secrets in this file
# or in the repository. Keep .env gitignored.
# AWS_ROLE_ARN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
